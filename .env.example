# Copy to .env and fill in. .env is gitignored; this template is not.
#
#   cp .env.example .env

# NCBI requires a contact address for programmatic Entrez access, and will
# throttle or block unidentified clients. Required by `virotrace acquire`.
VIROTRACE_NCBI_EMAIL=

# Optional. Raises the Entrez rate limit from 3 to 10 requests/second.
# Generate at NCBI > Account settings > API Key Management.
VIROTRACE_NCBI_API_KEY=
