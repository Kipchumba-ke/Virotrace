def _fake_iqtree(tree_text: str):
    def runner(command):
        prefix = Path(command[command.index("--prefix") + 1])
        prefix.with_suffix(".treefile").write_text(tree_text + "\n")
        prefix.with_suffix(".log").write_text("log\n")

    return runner


