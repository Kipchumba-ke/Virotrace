def test_parse_newick_ignores_support_labels_and_numbers_tips_in_preorder():
    tree = parse_newick("((A:1,B:2)95.5/100:0.5,C:3,D:4);")
    assert [tree.name[t] for t in tree.tips] == ["A", "B", "C", "D"]
